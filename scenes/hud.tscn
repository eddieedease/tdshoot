[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/crosshair.gd" id="3_cross"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar"]
content_margin_left = 28.0
content_margin_top = 10.0
content_margin_right = 28.0
content_margin_bottom = 12.0
bg_color = Color(0.06, 0.07, 0.09, 0.88)
border_width_bottom = 4
border_color = Color(0.93, 0.45, 0.13, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hp_bg"]
bg_color = Color(0.2, 0.08, 0.08, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hp_fill"]
bg_color = Color(0.85, 0.2, 0.18, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="HUD" type="CanvasLayer"]
layer = 10
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="TopBar" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bar")

[node name="HBox" type="HBoxContainer" parent="Root/TopBar"]
layout_mode = 2
theme_override_constants/separation = 48

[node name="HealthTitle" type="Label" parent="Root/TopBar/HBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.45, 0.4, 1)
text = "HEALTH"

[node name="HealthBar" type="ProgressBar" parent="Root/TopBar/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 24)
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/background = SubResource("StyleBoxFlat_hp_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_hp_fill")
value = 100.0
show_percentage = false

[node name="AmmoLabel" type="Label" parent="Root/TopBar/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.35, 1)
text = "AMMO  30 / 90"

[node name="KeysLabel" type="Label" parent="Root/TopBar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.25, 1)
text = "KEYS  0"

[node name="CreditsLabel" type="Label" parent="Root/TopBar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 1, 0.65, 1)
text = "CREDITS  0"

[node name="NestsLabel" type="Label" parent="Root/TopBar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.5, 1, 1)
text = "NESTS  0"

[node name="Spacer" type="Control" parent="Root/TopBar/HBox"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="ScoreLabel" type="Label" parent="Root/TopBar/HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "SCORE  000000"

[node name="Message" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 130.0
offset_bottom = 180.0
grow_horizontal = 2
theme_override_font_sizes/font_size = 38
horizontal_alignment = 1

[node name="Crosshair" type="Control" parent="Root"]
unique_name_in_owner = true
anchors_preset = 0
mouse_filter = 2
script = ExtResource("3_cross")

[node name="Overlay" type="ColorRect" parent="Root"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="Root/Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Root/Overlay/Center"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Root/Overlay/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="OverlayTitle" type="Label" parent="Root/Overlay/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.45, 0.13, 1)
theme_override_font_sizes/font_size = 64
text = "PAUSED"
horizontal_alignment = 1

[node name="OverlayInfo" type="Label" parent="Root/Overlay/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Root/Overlay/Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2

[node name="Button1" type="Button" parent="Root/Overlay/Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "RESUME"

[node name="Button2" type="Button" parent="Root/Overlay/Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "RESTART"

[node name="Button3" type="Button" parent="Root/Overlay/Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "MAIN MENU"
